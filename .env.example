# =============================================================================
# RAGProject 环境变量示例
# 复制本文件为 .env 后填写真实配置：
#   Copy-Item .env.example .env       # PowerShell
#
# 请勿在本文件或 Git 仓库中提交真实 API Key、Token 或数据库密码。
# =============================================================================

# -----------------------------------------------------------------------------
# MinerU：PDF 结构化解析（NodePDFToMD 必填）
# -----------------------------------------------------------------------------
MINERU_API=your_mineru_api_token

# -----------------------------------------------------------------------------
# 视觉语言模型：Markdown 图片理解（NodeMDImg 必填）
# 需要使用兼容 OpenAI Chat Completions 接口、且支持图片输入的模型。
# -----------------------------------------------------------------------------
VL_MODEL_NAME=your_vision_model_name
VL_API_KEY=your_vision_model_api_key
VL_BASE_URL=https://your-openai-compatible-provider.example/v1
VL_TEMPERATURE=0
